{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolHub",
  "version": "0.2.3",
  "identifier": "com.toolhub.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ToolHub",
        "width": 980,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFRENDMkQ4RUE4NzMwMkUKUldRdU1JZnEyTUxjcnJoNzFzQ051QjJHWVNVOTV2NHQzaU1BK29KNThoOW03ajFhSDZqVXJLTTAK",
      "endpoints": [
        "https://github.com/wenaro1337/ToolHub/releases/latest/download/latest.json"
      ]
    }
  }
}
